pragma language_version >= 0.22;

import CompactStandardLibrary;

// Fix: the owner proves knowledge of a secret. The ledger stores only a
// domain-separated hash of it. (OpenZeppelin's ZOwnablePK packages this idea
// with a secret nonce; prefer the library in real contracts.)
export ledger owner_commit: Bytes<32>;
export ledger counter: Counter;

witness owner_secret(): Bytes<32>;

circuit owner_commitment(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "example:owner:v1"), secret]);
}

constructor() {
  owner_commit = disclose(owner_commitment(owner_secret()));
}

export circuit bump(): [] {
  assert(owner_commitment(owner_secret()) == owner_commit, "not owner");
  counter.increment(1);
}
