pragma language_version >= 0.22;
import CompactStandardLibrary;
export ledger owner: Bytes<32>;
export ledger used: Set<Bytes<32>>;
witness secret(): Bytes<32>;
export pure circuit key(s: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "p29:owner"), s]);
}
constructor(o: Bytes<32>) { owner = disclose(o); }
// Reads the secret twice: once to authorize, once for the nullifier.
export circuit claim(scope: Bytes<32>): [] {
  assert(key(secret()) == owner, "not owner");
  const n = persistentHash<Vector<3, Bytes<32>>>([pad(32, "p29:null"), disclose(scope), secret()]);
  assert(!used.member(disclose(n)), "used");
  used.insert(disclose(n));
}
