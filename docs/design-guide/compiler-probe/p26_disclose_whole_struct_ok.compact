pragma language_version >= 0.22;
import CompactStandardLibrary;
witness w(): Uint<64>;
witness wb(): Bytes<32>;
witness salt(): Bytes<32>;
witness wf(): Field;

struct P { a: Uint<64>; b: Uint<64>; }
witness prof(): P;
export ledger x: Uint<64>;
export circuit f(): [] { const p = disclose(prof()); x = p.a; }
