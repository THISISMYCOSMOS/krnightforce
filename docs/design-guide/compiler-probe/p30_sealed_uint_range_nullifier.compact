pragma language_version >= 0.22;
import CompactStandardLibrary;
export sealed ledger fee_cap: Uint<32>;
export ledger total: Uint<32>;
export ledger active: Boolean;
export ledger used: Set<Bytes<32>>;
witness amount(): Uint<16>;
witness secret(): Bytes<32>;
constructor(cap: Uint<32>) { fee_cap = disclose(cap); active = true; }
export circuit spend(round: Bytes<32>): [] {
  assert(active, "inactive");
  const a = amount();
  assert(a > 0 && a <= 1000, "amount out of range");
  const n = persistentHash<Vector<3, Bytes<32>>>([pad(32, "p30:null"), disclose(round), secret()]);
  assert(!used.member(disclose(n)), "already used");
  used.insert(disclose(n));
  total = disclose((total + a) as Uint<32>);
}
