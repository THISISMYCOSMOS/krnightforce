pragma language_version >= 0.22;

import CompactStandardLibrary;

// Same design, with the mistake seen in a hackathon project: the claim is
// hidden with a plain hash instead of a commitment (breaks criterion 4).
// It compiles; anyone can hash ages 0-255 and condition codes until one matches.
export ledger issuer_commit: Bytes<32>;
export ledger credentials: Map<Bytes<32>, Bytes<32>>;
export ledger verified_adult: Set<Bytes<32>>;

witness issuer_secret(): Bytes<32>;
witness patient_age(): Uint<8>;
witness patient_condition(): Uint<16>;

export pure circuit issuer_commitment(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "healthcred:issuer:v1"), secret]);
}

circuit claim_hash(age: Uint<8>, condition: Uint<16>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "healthcred:claim:v1"),
    age as Field as Bytes<32>,
    condition as Field as Bytes<32>
  ]);
}

constructor(issuer: Bytes<32>) {
  issuer_commit = disclose(issuer);
}

export circuit issue(id: Bytes<32>): [] {
  assert(issuer_commitment(issuer_secret()) == issuer_commit, "not the issuer");
  credentials.insert(disclose(id), disclose(claim_hash(patient_age(), patient_condition())));
}

export circuit verifyAdult(id: Bytes<32>): [] {
  assert(credentials.member(disclose(id)), "unknown credential");
  const age = patient_age();
  assert(credentials.lookup(disclose(id)) == disclose(claim_hash(age, patient_condition())), "claim does not match");
  assert(disclose(age >= 18), "under 18");
  verified_adult.insert(disclose(id));
}
