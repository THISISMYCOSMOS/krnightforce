pragma language_version >= 0.22;

import CompactStandardLibrary;

// Health credential, built from the design walkthrough
// (docs/design-guide/walkthrough-health-credential.md).
// Hidden: age, condition code. Revealed: credential id, "age >= 18" at verification.
// Vouched for by: the issuer fixed at deployment.
export ledger issuer_commit: Bytes<32>;
export ledger credentials: Map<Bytes<32>, Bytes<32>>;
export ledger verified_adult: Set<Bytes<32>>;

witness issuer_secret(): Bytes<32>;
witness patient_age(): Uint<8>;
witness patient_condition(): Uint<16>;
witness claim_nonce(): Bytes<32>;

export pure circuit issuer_commitment(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "healthcred:issuer:v1"), secret]);
}

// Criterion 4, 5: a commitment with a fresh nonce, not a hash.
// Helpers take values, not witness calls: each witness is read once per circuit
// (probe p29), so the value checked against the commitment is the value used.
circuit claim_commitment(age: Uint<8>, condition: Uint<16>, nonce: Bytes<32>): Bytes<32> {
  return persistentCommit<Vector<2, Bytes<32>>>([
    age as Field as Bytes<32>,
    condition as Field as Bytes<32>
  ], nonce);
}

constructor(issuer: Bytes<32>) {
  issuer_commit = disclose(issuer);
}

// Criterion 10, 11: only the issuer, proven by its secret.
export circuit issue(id: Bytes<32>): [] {
  assert(issuer_commitment(issuer_secret()) == issuer_commit, "not the issuer");
  credentials.insert(disclose(id), claim_commitment(patient_age(), patient_condition(), claim_nonce()));
}

// Criterion 6: only the fact "18 or over" is revealed.
export circuit verifyAdult(id: Bytes<32>): [] {
  assert(credentials.member(disclose(id)), "unknown credential");
  const age = patient_age();
  assert(credentials.lookup(disclose(id)) == claim_commitment(age, patient_condition(), claim_nonce()), "claim does not match");
  assert(disclose(age >= 18), "under 18");
  verified_adult.insert(disclose(id));
}
