pragma language_version >= 0.22;

import CompactStandardLibrary;

// Raffle with hidden ticket numbers (0..999). Buyers commit to a number;
// the organizer reveals a pre-committed winning number; holders of that number
// claim. Payment handling is out of scope.

export struct Ticket {
  number: Uint<16>;
  nonce: Uint<64>;
}

export struct DrawSecret {
  domain: Bytes<32>;
  number: Uint<16>;
  salt: Bytes<32>;
}

export ledger organizer: Bytes<32>;
export ledger drawCommitment: Bytes<32>;
export ledger salesOpen: Boolean;
export ledger drawn: Boolean;
export ledger winningNumber: Uint<16>;
export ledger ticketsSold: Counter;
export ledger tickets: Set<Bytes<32>>;
export ledger claims: Set<Bytes<32>>;
export ledger payouts: Set<Bytes<32>>;

witness organizerSecret(): Bytes<32>;
witness ticketNumber(): Uint<16>;

circuit organizerKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "raffle:organizer"), sk]);
}

// drawCommit = hash(DrawSecret) chosen by the organizer before sales start
constructor(drawCommit: Bytes<32>) {
  organizer = disclose(organizerKey(organizerSecret()));
  drawCommitment = disclose(drawCommit);
  salesOpen = true;
  drawn = false;
}

export circuit buyTicket(): [] {
  assert(salesOpen, "sales closed");
  const n = ticketNumber();
  assert(n < 1000, "ticket number must be 0..999");
  // nonce makes every ticket unique
  const t = persistentHash<Ticket>(Ticket { number: n, nonce: ticketsSold.read() });
  tickets.insert(disclose(t));
  ticketsSold.increment(1);
}

export circuit draw(number: Uint<16>, salt: Bytes<32>): [] {
  assert(organizerKey(organizerSecret()) == organizer, "only organizer");
  assert(salesOpen, "already drawn");
  assert(persistentHash<DrawSecret>(DrawSecret { domain: pad(32, "raffle:draw"), number: number, salt: salt }) == drawCommitment, "does not match commitment");
  salesOpen = false;
  drawn = true;
  winningNumber = disclose(number);
}

// myNonce: the ticketsSold value at purchase time, remembered by the wallet
export circuit claimPrize(myNonce: Uint<64>, payTo: Bytes<32>): [] {
  assert(drawn, "not drawn yet");
  assert(ticketNumber() == winningNumber, "not a winning ticket");
  const t = persistentHash<Ticket>(Ticket { number: ticketNumber(), nonce: myNonce });
  assert(tickets.member(disclose(t)), "unknown ticket");
  assert(!claims.member(disclose(t)), "already claimed");
  claims.insert(disclose(t));
  payouts.insert(disclose(payTo));
}
